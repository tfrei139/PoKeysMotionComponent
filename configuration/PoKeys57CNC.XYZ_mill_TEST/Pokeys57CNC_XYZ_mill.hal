#*******************
# LinuxCNC EMC
#*******************

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_spindles=[TRAJ]SPINDLES

#*******************
# PoKeys components
#*******************

loadusr -W PoKeysController
setp PoKeysController.0.axis.0.step-scale [PoKeysController.0]AXIS0_STEP_SCALE
setp PoKeysController.0.axis.1.step-scale [PoKeysController.0]AXIS1_STEP_SCALE
setp PoKeysController.0.axis.2.step-scale [PoKeysController.0]AXIS2_STEP_SCALE

loadrt PoKeysMotionBuffer personality=[PoKeysController.0]NUMBER_AXES
setp PoKeysMotionBuffer.0.axis.0.step-scale [PoKeysController.0]AXIS0_STEP_SCALE
setp PoKeysMotionBuffer.0.axis.1.step-scale [PoKeysController.0]AXIS1_STEP_SCALE
setp PoKeysMotionBuffer.0.axis.2.step-scale [PoKeysController.0]AXIS2_STEP_SCALE
setp PoKeysMotionBuffer.0.axis.0.following-error 0.05
setp PoKeysMotionBuffer.0.axis.1.following-error 0.05
setp PoKeysMotionBuffer.0.axis.2.following-error 0.05

# external output signals
net machine-is-on <= halui.machine.is-on
net machine-is-on => PoKeysMotionBuffer.0.machine-is-on
net machine-is-on => PoKeysController.0.machine-is-on

#*******************
# E-Stop latch component
#*******************

loadrt estop_latch

net estop-loopout estop-latch.0.ok-out => iocontrol.0.emc-enable-in
net estop-loopin iocontrol.0.user-enable-out => estop-latch.0.ok-in
net estop-reset iocontrol.0.user-request-enable => estop-latch.0.reset
net remote-estop estop-latch.0.fault-in <= PoKeysController.0.machine-estop

#*******************
# Assign RT functions
#*******************

addf motion-command-handler   servo-thread
addf motion-controller        servo-thread
addf PoKeysMotionBuffer.0     servo-thread
addf estop-latch.0            servo-thread

#*******************
# Axis X
#*******************

net x-homing <= joint.0.homing
net x-homing => PoKeysController.0.motion.override-limit.0

net x-override-limit <= halui.joint.0.override-limits
net x-override-limit => PoKeysController.0.motion.override-limit.1

net x-pos-cmd      <= joint.0.motor-pos-cmd
net x-pos-cmd      => PoKeysMotionBuffer.0.axis.0.position-command

net x-pos-fb       <= PoKeysController.0.axis.0.position-feedback
net x-pos-fb       => joint.0.motor-pos-fb

net min-x          <=  PoKeysController.0.axis.0.limit-negative
net min-x          =>  joint.0.neg-lim-sw-in
net max-x          <=  PoKeysController.0.axis.0.limit-positive
net max-x          =>  joint.0.pos-lim-sw-in
net home-x         <=  PoKeysController.0.axis.0.home
net home-x         =>  joint.0.home-sw-in

#*******************
# Axis Y
#*******************

net y-homing <= joint.1.homing
net y-homing => PoKeysController.0.motion.override-limit.2

net y-override-limit <= halui.joint.1.override-limits
net y-override-limit => PoKeysController.0.motion.override-limit.3

net y-pos-cmd      <= joint.1.motor-pos-cmd
net y-pos-cmd      => PoKeysMotionBuffer.0.axis.1.position-command

net y-pos-fb       <= PoKeysController.0.axis.1.position-feedback
net y-pos-fb       => joint.1.motor-pos-fb

net min-y          <=  PoKeysController.0.axis.1.limit-negative
net min-y          =>  joint.1.neg-lim-sw-in
net max-y          <=  PoKeysController.0.axis.1.limit-positive
net max-y          =>  joint.1.pos-lim-sw-in
net home-y         <=  PoKeysController.0.axis.1.home
net home-y         =>  joint.1.home-sw-in

#*******************
# Axis Z
#*******************

net z-homing <= joint.2.homing
net z-homing => PoKeysController.0.motion.override-limit.4

net z-override-limit <= halui.joint.2.override-limits
net z-override-limit => PoKeysController.0.motion.override-limit.5

net z-pos-cmd      <= joint.2.motor-pos-cmd
net z-pos-cmd      => PoKeysMotionBuffer.0.axis.2.position-command

net z-pos-fb       <= PoKeysController.0.axis.2.position-feedback
net z-pos-fb       => joint.2.motor-pos-fb

net min-z          <=  PoKeysController.0.axis.2.limit-negative
net max-z          =>  joint.2.pos-lim-sw-in
net max-z          <=  PoKeysController.0.axis.2.limit-positive
net max-z          =>  joint.2.pos-lim-sw-in
net home-z         <=  PoKeysController.0.axis.2.home
net home-z         =>  joint.2.home-sw-in

#*******************
# SPINDLE
#*******************

loadrt scale count=1
addf scale.0 servo-thread
# 100 % / 1'000 RPM max
setp scale.0.gain 0.1

net spindle-speed-scale <= spindle.0.speed-out-abs
net spindle-speed-scale => scale.0.in
net spindle-speed-pwm <= scale.0.out
net spindle-speed-pwm => PoKeysController.0.io.pwm-pin.0

net spindle-enable <= spindle.0.on
net spindle-enable => PoKeysController.0.io.solid-state-relay.0

#*******************
# Probe
#*******************

net probe-in     <=  PoKeysController.0.io.input-pin.0
net probe-in     =>  motion.probe-input

#******************************
# MPG
#******************************

# TODO hook up pin to enable from device
# net mpg-scale <= PoKeysController.0.io.
#net mpg-x axis.x.jog-enable <= mpg-enable
#net mpg-y axis.y.jog-enable <= mpg-enable
#net mpg-z axis.z.jog-enable <= mpg-enable

net mpg-counts <= PoKeysController.0.io.encoder.0.count
net mpg-counts => joint.0.jog-counts
net mpg-counts => joint.1.jog-counts
net mpg-counts => joint.2.jog-counts

# axis jogging only possible if machine is homed
#net mpg-counts => axis.x.jog-counts
#net mpg-counts => axis.y.jog-counts
#net mpg-counts => axis.z.jog-counts

# TODO hook up and convert selected pin to value? Example Mux4 component
# net mpg-scale <= PoKeysController.0.io.
#net mpg-scale => axis.x.jog-scale
#net mpg-scale => axis.y.jog-scale
#net mpg-scale => axis.z.jog-scale

#******************************
# manual tool change signals
#******************************

loadusr -W hal_manualtoolchange
net tool-change-request     iocontrol.0.tool-change       =>  hal_manualtoolchange.change
net tool-change-confirmed   iocontrol.0.tool-changed      <=  hal_manualtoolchange.changed
net tool-number             iocontrol.0.tool-prep-number  =>  hal_manualtoolchange.number
net tool-prepare-loopback   iocontrol.0.tool-prepare      =>  iocontrol.0.tool-prepared

